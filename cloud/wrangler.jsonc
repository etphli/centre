{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "centre-cloud",
  "main": "index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "../dist-iphone",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "centre-production",
      "database_id": "16c45b97-0c59-4293-9c79-e1f1aa0ef081",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "9a11949235ee2de5a154b31a725c464b",
  "ai": {
    "binding": "AI"
  }
}
